`timescale 1ns/1ps
module tb_forksheet_core;

reg        clk, rst_n, data_valid;
reg [63:0] data_in;
wire [63:0] via_data_up;
wire        via_valid, logic_leap, calc_done;
wire [2:0]  core_state;

forksheet_core dut (
    .clk(clk), .rst_n(rst_n),
    .data_in(data_in), .data_valid(data_valid),
    .via_data_up(via_data_up), .via_valid(via_valid),
    .logic_leap(logic_leap), .core_state(core_state),
    .calc_done(calc_done)
);

initial clk = 0;
always #5 clk = ~clk;
integer pass_cnt = 0, fail_cnt = 0;

initial begin
    $dumpfile("forksheet_core.vcd");
    $dumpvars(0, tb_forksheet_core);
end

task check;
    input cond; input [127:0] label;
    begin
        if (cond) begin $display("[PASS] %s",label); pass_cnt=pass_cnt+1; end
        else      begin $display("[FAIL] %s",label); fail_cnt=fail_cnt+1; end
    end
endtask

task wait_calc;
    integer i;
    begin
        for(i=0;i<50;i=i+1) begin
            @(posedge clk); #1;
            if(calc_done) i=50;
        end
    end
endtask

initial begin
    $display("===========================================");
    $display("  forksheet_core Verification V2.0");
    $display("===========================================");
    rst_n=0; data_in=0; data_valid=0;
    repeat(3) @(posedge clk); rst_n=1; @(posedge clk); #1;
    check(core_state===3'd0, "TC01_reset_to_IDLE");
    check(via_valid===1'b0,  "TC01_via_valid_low");
    check(calc_done===1'b0,  "TC01_calc_done_low");
    @(negedge clk); data_in=64'hDEADBEEFCAFEBABE; data_valid=1;
    @(posedge clk); #1; data_valid=0;
    wait_calc;
    check(calc_done===1'b1, "TC02_calc_done_asserted");
    repeat(5) @(posedge clk); #1;
    check(via_data_up!==64'd0, "TC03_via_data_nonzero");
    @(negedge clk); rst_n=0; repeat(2) @(posedge clk); rst_n=1;
    @(negedge clk); data_in=64'hFFFFFFFFFFFFFFFF; data_valid=1;
    @(posedge clk); #1; data_valid=0;
    begin : wl integer j; for(j=0;j<30;j=j+1) begin
        @(posedge clk); #1; if(core_state===3'd3) j=30; end end
    check(logic_leap===1'b1||calc_done===1'b1, "TC04_logic_leap_triggered");
    @(negedge clk); rst_n=0; repeat(2) @(posedge clk); rst_n=1;
    @(negedge clk); data_in=64'd0; data_valid=1;
    @(posedge clk); #1; data_valid=0;
    wait_calc; repeat(5) @(posedge clk); #1;
    check(via_data_up!==64'd0, "TC05_zero_input_ARX_nonzero");
    begin : dt reg [63:0] s1,s2;
        @(negedge clk); rst_n=0; repeat(2) @(posedge clk); rst_n=1;
        @(negedge clk); data_in=64'hAAAAAAAAAAAAAAAA; data_valid=1;
        @(posedge clk); #1; data_valid=0; wait_calc;
        repeat(5) @(posedge clk); #1; s1=via_data_up;
        @(negedge clk); rst_n=0; repeat(2) @(posedge clk); rst_n=1;
        @(negedge clk); data_in=64'h5555555555555555; data_valid=1;
        @(posedge clk); #1; data_valid=0; wait_calc;
        repeat(5) @(posedge clk); #1; s2=via_data_up;
        check(s1!==s2, "TC06_diff_inputs_diff_outputs");
    end
    @(negedge clk); rst_n=0; repeat(2) @(posedge clk); rst_n=1; @(posedge clk); #1;
    check(core_state===3'd0, "TC07_reset_clears_state");
    check(via_valid===1'b0,  "TC07_reset_clears_via_valid");
    check(calc_done===1'b0,  "TC07_reset_clears_calc_done");
    $display("===========================================");
    $display("  PASSED: %0d | FAILED: %0d",pass_cnt,fail_cnt);
    if(fail_cnt==0) $display("  forksheet_core ALL PASSED");
    $display("===========================================");
    $finish;
end
initial begin #200000; $display("[TIMEOUT]"); $finish; end
endmodule
