`timescale 1ns/1ps
module tb_chip3d_security_top;
reg clk,rst_n,data_valid; reg [63:0] data_in,stored_biohash,stored_physxor;
wire sys_pass,sys_fail,brake_active,hard_shutdown; wire [63:0] via_data_out;
chip3d_security_top dut(.clk(clk),.rst_n(rst_n),.data_in(data_in),
    .data_valid(data_valid),.stored_biohash(stored_biohash),
    .stored_physxor(stored_physxor),.sys_pass(sys_pass),.sys_fail(sys_fail),
    .brake_active(brake_active),.hard_shutdown(hard_shutdown),.via_data_out(via_data_out));
initial clk=0; always #5 clk=~clk;
integer pass_cnt=0,fail_cnt=0;
initial begin $dumpfile("chip3d_top.vcd"); $dumpvars(0,tb_chip3d_security_top); end
task check; input cond; input [191:0] label; begin
    if(cond) begin $display("[PASS] %s",label); pass_cnt=pass_cnt+1; end
    else     begin $display("[FAIL] %s",label); fail_cnt=fail_cnt+1; end
end endtask
task do_rst; begin @(negedge clk);rst_n=0;data_valid=0;
    repeat(2)@(posedge clk);rst_n=1;@(posedge clk);#1; end endtask
task wait_r; integer i; begin for(i=0;i<100;i=i+1) begin
    @(posedge clk);#1;if(sys_pass||sys_fail) i=100; end end endtask
initial begin
    $display("===========================================");
    $display("  chip3d_security_top Full-Chain V2.0");
    $display("===========================================");
    rst_n=0;data_in=0;data_valid=0;
    stored_biohash=64'hDEADBEEFCAFEBABE;
    stored_physxor=64'hDEADBEEFCAFEBABE;
    repeat(3)@(posedge clk);rst_n=1;@(posedge clk);#1;
    check(sys_pass===1'b0,      "TC01_reset_sys_pass_low");
    check(sys_fail===1'b0,      "TC01_reset_sys_fail_low");
    check(brake_active===1'b0,  "TC01_reset_brake_inactive");
    check(hard_shutdown===1'b0, "TC01_reset_no_shutdown");
    $display("--- Full chain: valid data ---");
    @(negedge clk);data_in=64'hDEADBEEFCAFEBABE;data_valid=1;
    @(posedge clk);#1;data_valid=0;
    wait_r;
    check(sys_pass===1'b1, "TC02_full_chain_pass");
    check(sys_fail===1'b0, "TC02_no_fail_on_valid");
    $display("--- Full chain: invalid data ---");
    do_rst;stored_biohash=64'hDEADBEEFCAFEBABE;stored_physxor=64'hDEADBEEFCAFEBABE;
    @(negedge clk);data_in=64'h0000000000000001;data_valid=1;
    @(posedge clk);#1;data_valid=0;
    wait_r;
    check(sys_fail===1'b1,  "TC03_full_chain_fail");
    repeat(30)@(posedge clk);#1;
    check(brake_active===1'b1, "TC04_brake_after_fail");
    repeat(40)@(posedge clk);#1;
    check(hard_shutdown===1'b1,"TC05_hard_shutdown");
    @(negedge clk);data_valid=1;data_in=64'hDEADBEEFCAFEBABE;
    @(posedge clk);#1;data_valid=0;
    repeat(10)@(posedge clk);#1;
    check(hard_shutdown===1'b1,"TC06_shutdown_persists");
    do_rst;
    check(sys_pass===1'b0,      "TC07_reset_clears_pass");
    check(sys_fail===1'b0,      "TC07_reset_clears_fail");
    check(brake_active===1'b0,  "TC07_reset_clears_brake");
    check(hard_shutdown===1'b0, "TC07_reset_releases_shutdown");
    $display("--- Recovery after reset ---");
    @(negedge clk);data_in=64'hDEADBEEFCAFEBABE;data_valid=1;
    @(posedge clk);#1;data_valid=0;
    wait_r;
    check(sys_pass===1'b1,"TC08_recovery_pass");
    $display("===========================================");
    $display("  PASSED: %0d | FAILED: %0d",pass_cnt,fail_cnt);
    if(fail_cnt==0) begin
        $display("  chip3d_security_top ALL PASSED");
        $display("  3D Security SoC ready for tapeout");
    end else $display("  FAILED - fix RTL");
    $display("===========================================");
    $finish;
end
initial begin #500000;$display("[TIMEOUT]");$finish; end
endmodule
