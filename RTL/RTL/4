// ============================================================
// tsv_channel — 3D Chip Security Logic Lock
// Through-Silicon VIA: Vertical inter-layer data routing
// Simulator: Icarus Verilog 12.0 | EDA Playground
// ============================================================
module tsv_channel (
    input  wire        clk,
    input  wire        rst_n,
    input  wire [63:0] data_from_core,
    input  wire        valid_from_core,
    output reg  [63:0] data_to_audit,
    output reg         valid_to_audit,
    input  wire        pass_from_audit,
    input  wire        fail_from_audit,
    output reg         pass_to_base,
    output reg         fail_to_base,
    output reg  [1:0]  tsv_state,
    output reg         tsv_busy
);

localparam TSV_IDLE = 2'd0;
localparam TSV_UP   = 2'd1;
localparam TSV_DOWN = 2'd2;
localparam TSV_DONE = 2'd3;

always @(posedge clk or negedge rst_n) begin
    if (!rst_n) begin
        tsv_state<=TSV_IDLE; data_to_audit<=64'd0;
        valid_to_audit<=1'b0; pass_to_base<=1'b0;
        fail_to_base<=1'b0; tsv_busy<=1'b0;
    end else begin
        case (tsv_state)
            TSV_IDLE: begin
                valid_to_audit<=1'b0; pass_to_base<=1'b0;
                fail_to_base<=1'b0; tsv_busy<=1'b0;
                if(valid_from_core) begin tsv_state<=TSV_UP; tsv_busy<=1'b1; end
            end
            TSV_UP: begin
                data_to_audit<=data_from_core;
                valid_to_audit<=1'b1;
                tsv_state<=TSV_DOWN;
            end
            TSV_DOWN: begin
                valid_to_audit<=1'b0;
                if(pass_from_audit||fail_from_audit) begin
                    pass_to_base<=pass_from_audit;
                    fail_to_base<=fail_from_audit;
                    tsv_state<=TSV_DONE;
                end
            end
            TSV_DONE: begin tsv_busy<=1'b0; tsv_state<=TSV_IDLE; end
            default:  tsv_state<=TSV_IDLE;
        endcase
    end
end
endmodule
