// ============================================================
// m2_intercept — 3D Chip Security Logic Lock
// M2 Audit Layer: PGU Logic Array + Five Axioms Check
// Simulator: Icarus Verilog 12.0 | EDA Playground
// ============================================================
module m2_intercept (
    input  wire        clk,
    input  wire        rst_n,
    input  wire [63:0] via_data,
    input  wire        via_valid,
    input  wire [63:0] stored_biohash,
    input  wire [63:0] stored_physxor,
    output reg         axiom1_pass,
    output reg         axiom2_pass,
    output reg         axiom3_pass,
    output reg         axiom4_pass,
    output reg         axiom5_pass,
    output reg         intercept_pass,
    output reg         intercept_fail,
    output reg  [2:0]  audit_state
);

localparam A_IDLE    = 3'd0;
localparam A_SAMPLE  = 3'd1;
localparam A_PGU     = 3'd2;
localparam A_AXIOM   = 3'd3;
localparam A_VERDICT = 3'd4;
localparam A_FAIL    = 3'd5;

reg [63:0] sd;
reg [3:0]  ac;
reg [6:0]  hw_reg;

function [6:0] hw64;
    input [63:0] v; integer k; reg [6:0] c;
    begin c=0; for(k=0;k<64;k=k+1) c=c+v[k]; hw64=c; end
endfunction

always @(posedge clk or negedge rst_n) begin
    if (!rst_n) begin
        audit_state<=A_IDLE; axiom1_pass<=0; axiom2_pass<=0;
        axiom3_pass<=0; axiom4_pass<=0; axiom5_pass<=0;
        intercept_pass<=0; intercept_fail<=0;
        sd<=64'd0; ac<=4'd0; hw_reg<=7'd0;
    end else begin
        case (audit_state)
            A_IDLE: begin
                intercept_pass<=0; intercept_fail<=0;
                axiom1_pass<=0; axiom2_pass<=0;
                axiom3_pass<=0; axiom5_pass<=0;
                if(via_valid) begin sd<=via_data; audit_state<=A_SAMPLE; end
            end
            A_SAMPLE: begin
                axiom4_pass<=1'b1;
                hw_reg<=hw64(via_data);
                audit_state<=A_PGU;
            end
            A_PGU: begin audit_state<=A_AXIOM; ac<=4'd0; end
            A_AXIOM: begin
                axiom1_pass<=(sd==stored_biohash);
                axiom2_pass<=((sd^stored_physxor)==64'd0);
                axiom3_pass<=(hw_reg>=7'd16 && hw_reg<=7'd48);
                axiom5_pass<=((sd[63]^sd[0]^sd[31]^sd[32])==1'b0);
                if(ac>=4'd1) audit_state<=A_VERDICT;
                ac<=ac+1;
            end
            A_VERDICT: begin
                if(axiom1_pass&&axiom2_pass&&axiom3_pass&&
                   axiom4_pass&&axiom5_pass)
                    begin intercept_pass<=1'b1; intercept_fail<=1'b0; audit_state<=A_IDLE; end
                else
                    begin intercept_pass<=1'b0; intercept_fail<=1'b1; audit_state<=A_FAIL; end
            end
            A_FAIL: begin intercept_fail<=1'b1; intercept_pass<=1'b0; end
            default: audit_state<=A_IDLE;
        endcase
    end
end
endmodule
