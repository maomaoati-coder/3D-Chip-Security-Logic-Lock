module forksheet_core (
    input  wire        clk,
    input  wire        rst_n,
    input  wire [63:0] data_in,
    input  wire        data_valid,
    output reg  [63:0] via_data_up,
    output reg         via_valid,
    output reg         logic_leap,
    output reg  [2:0]  core_state,
    output reg         calc_done
);

localparam IDLE     = 3'd0;
localparam FETCH    = 3'd1;
localparam PROCESS  = 3'd2;
localparam LEAP     = 3'd3;
localparam TRANSMIT = 3'd4;
localparam WAIT_ACK = 3'd5;

reg [63:0] ca, cb, cr;
reg [3:0]  pc;

function [63:0] farx;
    input [63:0] a, b;
    reg [63:0] t;
    begin
        t = a + b;
        t = (t << 17) | (t >> 47);
        t = t ^ b;
        t = t + 64'h6c62272e07bb0142;
        farx = t;
    end
endfunction

always @(posedge clk or negedge rst_n) begin
    if (!rst_n) begin
        core_state  <= IDLE;
        via_data_up <= 64'd0;
        via_valid   <= 1'b0;
        logic_leap  <= 1'b0;
        calc_done   <= 1'b0;
        ca <= 64'd0; cb <= 64'd0; cr <= 64'd0;
        pc <= 4'd0;
    end else begin
        case (core_state)
            IDLE: begin
                via_valid  <= 1'b0;
                logic_leap <= 1'b0;
                calc_done  <= 1'b0;
                if (data_valid) core_state <= FETCH;
            end
            FETCH: begin
                ca <= data_in;
                cb <= data_in ^ 64'h9e3779b97f4a7c15;
                pc <= 4'd0;
                core_state <= PROCESS;
            end
            PROCESS: begin
                cr <= farx(ca, cb);
                ca <= cb;
                cb <= farx(ca, cb);
                pc <= pc + 1;
                if (pc >= 4'd3) core_state <= LEAP;
            end
            LEAP: begin
                logic_leap <= 1'b1;
                calc_done  <= 1'b1;
                core_state <= TRANSMIT;
            end
            TRANSMIT: begin
                via_data_up <= cr;
                via_valid   <= 1'b1;
                logic_leap  <= 1'b0;
                core_state  <= WAIT_ACK;
            end
            WAIT_ACK: begin
                via_valid  <= 1'b0;
                core_state <= IDLE;
            end
            default: core_state <= IDLE;
        endcase
    end
end
endmodule
